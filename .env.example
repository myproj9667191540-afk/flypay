PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/flypay

# Gmail SMTP (create a Google App Password; do not use your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_TO=the-email-address-that-should-receive-contact-messages@gmail.com
MAIL_FROM_NAME=FlyPay Website
